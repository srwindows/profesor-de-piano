+/*
+ * PianoBooster derivative (2026), GNU GPLv3 or later.
+ * Apple's own DLS synthesizer and default CoreAudio output, without FluidSynth.
+ */
+#include "MidiDeviceCoreAudio.h"
+#ifdef __APPLE__
+#include <AudioUnit/AudioUnit.h>
+#include <QDebug>
+CMidiDeviceCoreAudio::~CMidiDeviceCoreAudio() {closeMidiPort(MIDI_OUTPUT,-1);}
+QStringList CMidiDeviceCoreAudio::getMidiPortList(midiType_t type) {
+    return type==MIDI_OUTPUT?QStringList{name()}:QStringList{};
+}
+bool CMidiDeviceCoreAudio::openMidiPort(midiType_t type,const QString &port) {
+    if(type!=MIDI_OUTPUT || port!=name())return false;
+    closeMidiPort(MIDI_OUTPUT,-1);
+    if(NewAUGraph(&graph)!=noErr || !graph)return false;
+    AudioComponentDescription music={};
+    music.componentType=kAudioUnitType_MusicDevice;
+    music.componentSubType=kAudioUnitSubType_DLSSynth;
+    music.componentManufacturer=kAudioUnitManufacturer_Apple;
+    AudioComponentDescription output={};
+    output.componentType=kAudioUnitType_Output;
+    output.componentSubType=kAudioUnitSubType_DefaultOutput;
+    output.componentManufacturer=kAudioUnitManufacturer_Apple;
+    AUNode musicNode=0,outputNode=0;
+    OSStatus err=AUGraphAddNode(graph,&music,&musicNode);
+    if(err==noErr)err=AUGraphAddNode(graph,&output,&outputNode);
+    if(err==noErr)err=AUGraphOpen(graph);
+    if(err==noErr)err=AUGraphNodeInfo(graph,musicNode,nullptr,&synth);
+    if(err==noErr && !synth)err=kAudio_ParamError;
+    if(err==noErr)err=AUGraphConnectNodeInput(graph,musicNode,0,outputNode,0);
+    if(err==noErr)err=AUGraphInitialize(graph);
+    if(err==noErr)err=AUGraphStart(graph);
+    if(err!=noErr){
+        qWarning()<<"CoreAudio DLS graph failed: OSStatus"<<err;
+        closeMidiPort(MIDI_OUTPUT,-1);
+        return false;
+    }
+    active=true;
+    qInfo()<<"CoreAudio native DLS sound output enabled";
+    return true;
+}
+void CMidiDeviceCoreAudio::closeMidiPort(midiType_t type,int index) {
+    Q_UNUSED(index)
+    if(type!=MIDI_OUTPUT)return;
+    active=false;
+    synth=nullptr;
+    if(graph){
+        Boolean running=false;
+        if(AUGraphIsRunning(graph,&running)==noErr && running)AUGraphStop(graph);
+        AUGraphUninitialize(graph);
+        AUGraphClose(graph);
+        DisposeAUGraph(graph);
+        graph=nullptr;
+    }
+}
+void CMidiDeviceCoreAudio::playMidiEvent(const CMidiEvent &ev) {
+    if(!active || !synth)return;
+    UInt32 status=0, d1=UInt32(ev.data1())&127, d2=UInt32(ev.data2())&127;
+    switch(ev.type()){
+        case MIDI_NOTE_OFF:status=MIDI_NOTE_OFF;break;
+        case MIDI_NOTE_ON:status=MIDI_NOTE_ON;break;
+        case MIDI_NOTE_PRESSURE:status=MIDI_NOTE_PRESSURE;break;
+        case MIDI_CONTROL_CHANGE:status=MIDI_CONTROL_CHANGE;break;
+        case MIDI_PROGRAM_CHANGE:status=MIDI_PROGRAM_CHANGE;d1=UInt32(ev.programme())&127;d2=0;break;
+        case MIDI_CHANNEL_PRESSURE:status=MIDI_CHANNEL_PRESSURE;d2=0;break;
+        case MIDI_PITCH_BEND:status=MIDI_PITCH_BEND;break;
+        default:return;
+    }
+    OSStatus err=MusicDeviceMIDIEvent(synth,status|(UInt32(ev.channel())&15),d1,d2,0);
+    if(err!=noErr)qWarning()<<"CoreAudio MIDI event OSStatus"<<err;
+}
+#endif
