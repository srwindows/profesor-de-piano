+OSStatus CMidiDeviceCoreAudio::meterCallback(void *context,
+        AudioUnitRenderActionFlags *flags,const AudioTimeStamp *,
+        UInt32,UInt32 frames,AudioBufferList *data) {
+    auto *state=static_cast<CallbackState*>(context);
+    if(!state || !state->owner || !flags || !data || !frames)return noErr;
+    if(!(*flags & kAudioUnitRenderAction_PostRender) ||
+       (*flags & kAudioUnitRenderAction_PostRenderError))return noErr;
+    auto *owner=state->owner;
+    if(!owner->active.load(std::memory_order_relaxed))return noErr;
+    if(*flags & kAudioUnitRenderAction_OutputIsSilence) {
+        owner->channelRms[state->channel].store(0.0f,std::memory_order_relaxed);
+        return noErr;
+    }
+    // Callback is in the real-time audio thread: no allocations or locks.
+    double sum=0.0;
+    size_t samples=0;
+    for(UInt32 b=0;b<data->mNumberBuffers;++b) {
+        const AudioBuffer &buf=data->mBuffers[b];
+        if(!buf.mData || buf.mDataByteSize<sizeof(Float32))continue;
+        const auto *pcm=static_cast<const Float32*>(buf.mData);
+        const size_t count=std::min<size_t>(
+            buf.mDataByteSize/sizeof(Float32),
+            size_t(frames)*std::max<UInt32>(1,buf.mNumberChannels));
+        for(size_t n=0;n<count;++n) {
+            const double x=pcm[n];
+            sum+=x*x;
+        }
+        samples+=count;
+    }
+    owner->channelRms[state->channel].store(
+        samples?float(std::sqrt(sum/double(samples))):0.0f,
+        std::memory_order_relaxed);
+    return noErr;
 }
